<Window x:Class="HonorBatterySaver.Tray.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:HonorBatterySaver.Core;assembly=HonorBatterySaver.Core"
        xmlns:i18n="clr-namespace:HonorBatterySaver.Tray"
        Title="{i18n:Localized App_Name}" Width="920" Height="760" MinWidth="780" MinHeight="640"
        Icon="{StaticResource AppLogoImage}" WindowStartupLocation="CenterScreen"
        Background="{DynamicResource CanvasBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI" UseLayoutRounding="True">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="17" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        </Style>
        <Style x:Key="BodyMuted" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="DiagnosticLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Margin" Value="0,9" />
        </Style>
        <Style x:Key="DiagnosticValue" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,9" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Padding" Value="18" />
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border HorizontalAlignment="Left" Padding="3" CornerRadius="11"
                                    Background="{DynamicResource ControlBrush}">
                                <TabPanel x:Name="HeaderPanel" IsItemsHost="True" Background="Transparent"
                                          KeyboardNavigation.TabIndex="1" />
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabSurface" Padding="{TemplateBinding Padding}" CornerRadius="8"
                                Background="Transparent">
                            <ContentPresenter ContentSource="Header" HorizontalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource ControlHoverBrush}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="True" />
                                    <Condition Property="IsMouseOver" Value="True" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="TabSurface" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Padding="22,17" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Image Width="44" Height="44" Source="{StaticResource AppLogoImage}" />
                <StackPanel Grid.Column="1" Margin="13,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{i18n:Localized App_Name}" FontSize="20" FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}" />
                    <TextBlock Text="{i18n:Localized App_Tagline}"
                               Foreground="{DynamicResource MutedTextBrush}" FontSize="12.5" />
                </StackPanel>
                <Border Grid.Column="2" Padding="12,7" CornerRadius="8"
                        Background="{DynamicResource StatusSurfaceBrush}" VerticalAlignment="Center">
                    <TextBlock x:Name="HeaderStatusText" Text="{i18n:Localized App_CheckingStatus}"
                               Foreground="{DynamicResource StatusTextBrush}"
                               FontSize="12.5" FontWeight="SemiBold" />
                </Border>
            </Grid>
        </Border>

        <TabControl x:Name="MainTabs" Grid.Row="1" Margin="18,12,18,10">
            <TabItem Header="{i18n:Localized Settings_Tab}">
                <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                    <StackPanel>
                        <Border Margin="0,0,0,12" Padding="18"
                                Background="{DynamicResource WarningSurfaceBrush}"
                                BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
                                CornerRadius="14">
                            <StackPanel>
                                <TextBlock Text="{i18n:Localized Disclaimer_ShortTitle}"
                                           FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                <TextBlock Margin="0,4,0,0" Style="{StaticResource BodyMuted}"
                                           Text="{i18n:Localized Disclaimer_ShortBody}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{i18n:Localized Settings_StartWithWindows}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource BodyMuted}"
                                               Text="{i18n:Localized Settings_StartWithWindowsDescription}" />
                                </StackPanel>
                                <CheckBox x:Name="AutostartCheckBox" Grid.Column="1" Margin="20,0,0,0"
                                          VerticalAlignment="Center" Content="{i18n:Localized Common_Enable}" />
                            </Grid>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{i18n:Localized Settings_Language}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource BodyMuted}"
                                               Text="{i18n:Localized Settings_LanguageDescription}" />
                                </StackPanel>
                                <ComboBox x:Name="LanguageComboBox" Grid.Column="1" Width="210" Margin="20,0,0,0"
                                          VerticalAlignment="Center" DisplayMemberPath="Name" SelectedValuePath="Language" />
                            </Grid>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{i18n:Localized Settings_AutomaticSwitching}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource BodyMuted}"
                                               Text="{i18n:Localized Settings_AutomaticSwitchingDescription}" />
                                </StackPanel>
                                <CheckBox x:Name="AutomaticCheckBox" Grid.Column="1" Margin="20,0,0,0"
                                          VerticalAlignment="Center" Content="{i18n:Localized Common_Enabled}" />
                            </Grid>
                        </Border>

                        <Border Margin="0,12,0,8" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="{i18n:Localized Settings_WifiRules}" Style="{StaticResource SectionTitle}" />
                                        <TextBlock Margin="0,4,0,0" Style="{StaticResource BodyMuted}"
                                                   Text="{i18n:Localized Settings_WifiRulesDescription}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource PrimaryButton}"
                                            Click="AddNetworkRule_Click" Content="{i18n:Localized Settings_AddRule}" />
                                </Grid>

                                <Grid Grid.Row="1" Margin="0,14,0,12">
                                    <Border CornerRadius="10" BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1" ClipToBounds="True">
                                        <DataGrid x:Name="RulesGrid" MinHeight="220" MaxHeight="310"
                                                  AutoGenerateColumns="False" CanUserAddRows="False" CanUserDeleteRows="False"
                                                  HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                                                  BorderThickness="0" RowHeight="54" ColumnHeaderHeight="40"
                                                  AlternationCount="2">
                                            <DataGrid.Columns>
                                                <DataGridTemplateColumn Header="{i18n:Localized Settings_EnabledColumn}" Width="70">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <CheckBox IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="{i18n:Localized Settings_WifiNetworkColumn}" Width="*">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <StackPanel VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Ssid}" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextBrush}" />
                                                                <TextBlock Text="{i18n:Localized Settings_ExactSsidMatch}" Margin="0,2,0,0" FontSize="11.5"
                                                                           Foreground="{DynamicResource MutedTextBrush}" />
                                                            </StackPanel>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                                <DataGridTemplateColumn Header="{i18n:Localized Settings_ChargingProfileColumn}" Width="220">
                                                    <DataGridTemplateColumn.CellTemplate>
                                                        <DataTemplate>
                                                            <Border HorizontalAlignment="Left" Padding="10,5" CornerRadius="7"
                                                                    Background="{DynamicResource BadgeBrush}">
                                                                <TextBlock FontSize="12.5" FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextBrush}">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock">
                                                                            <Setter Property="Text" Value="{i18n:Localized Mode_TravelRange}" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding Mode}" Value="{x:Static core:BatteryMode.Home}">
                                                                                    <Setter Property="Text" Value="{i18n:Localized Mode_HomeRange}" />
                                                                                </DataTrigger>
                                                                                <DataTrigger Binding="{Binding Mode}" Value="{x:Static core:BatteryMode.Office}">
                                                                                    <Setter Property="Text" Value="{i18n:Localized Mode_OfficeRange}" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                            </Border>
                                                        </DataTemplate>
                                                    </DataGridTemplateColumn.CellTemplate>
                                                </DataGridTemplateColumn>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                    </Border>
                                    <StackPanel x:Name="EmptyRulesMessage" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                        <TextBlock Text="{i18n:Localized Settings_NoRules}" FontSize="15" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextBrush}" HorizontalAlignment="Center" />
                                        <TextBlock Margin="0,4,0,0" Text="{i18n:Localized Settings_NoRulesDescription}"
                                                   Foreground="{DynamicResource MutedTextBrush}" />
                                    </StackPanel>
                                </Grid>

                                <DockPanel Grid.Row="2">
                                    <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center"
                                               Text="{i18n:Localized Settings_HigherRuleFirst}"
                                               Foreground="{DynamicResource MutedTextBrush}" FontSize="12.5" />
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <Button Margin="8,0,0,0" Click="EditRule_Click" Content="{i18n:Localized Common_Edit}" />
                                        <Button Margin="8,0,0,0" Click="MoveRuleUp_Click" Content="{i18n:Localized Settings_MoveUp}" />
                                        <Button Margin="8,0,0,0" Click="MoveRuleDown_Click" Content="{i18n:Localized Settings_MoveDown}" />
                                        <Button Margin="8,0,0,0" Click="DeleteRule_Click" Content="{i18n:Localized Common_Delete}" />
                                    </StackPanel>
                                </DockPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="{i18n:Localized Diagnostics_Tab}">
                <ScrollViewer Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
                    <StackPanel>
                        <Border Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="190" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock Grid.ColumnSpan="2" Text="{i18n:Localized Diagnostics_SystemStatus}" Style="{StaticResource SectionTitle}" Margin="0,0,0,8" />
                                <TextBlock Grid.Row="1" Text="Wi-Fi" Style="{StaticResource DiagnosticLabel}" />
                                <TextBlock x:Name="WifiValue" Grid.Row="1" Grid.Column="1" Style="{StaticResource DiagnosticValue}" />
                                <TextBlock Grid.Row="2" Text="{i18n:Localized Diagnostics_WifiAccess}" Style="{StaticResource DiagnosticLabel}" />
                                <TextBlock x:Name="WifiAccessValue" Grid.Row="2" Grid.Column="1" Style="{StaticResource DiagnosticValue}" />
                                <TextBlock Grid.Row="3" Text="{i18n:Localized Diagnostics_Power}" Style="{StaticResource DiagnosticLabel}" />
                                <TextBlock x:Name="PowerValue" Grid.Row="3" Grid.Column="1" Style="{StaticResource DiagnosticValue}" />
                                <TextBlock Grid.Row="4" Text="{i18n:Localized Diagnostics_SelectedMode}" Style="{StaticResource DiagnosticLabel}" />
                                <TextBlock x:Name="DecisionValue" Grid.Row="4" Grid.Column="1" Style="{StaticResource DiagnosticValue}" />
                                <TextBlock Grid.Row="5" Text="{i18n:Localized Diagnostics_AppliedMode}" Style="{StaticResource DiagnosticLabel}" />
                                <TextBlock x:Name="AppliedValue" Grid.Row="5" Grid.Column="1" Style="{StaticResource DiagnosticValue}" />
                                <TextBlock Grid.Row="6" Text="{i18n:Localized Diagnostics_ServiceAndWmi}" Style="{StaticResource DiagnosticLabel}" />
                                <TextBlock x:Name="ServiceValue" Grid.Row="6" Grid.Column="1" Style="{StaticResource DiagnosticValue}" />
                                <TextBlock Grid.Row="7" Text="{i18n:Localized Diagnostics_OemRegistry}" Style="{StaticResource DiagnosticLabel}" />
                                <TextBlock x:Name="RegistryValue" Grid.Row="7" Grid.Column="1" Style="{StaticResource DiagnosticValue}" />
                                <TextBlock Grid.Row="8" Text="{i18n:Localized Diagnostics_LastAttempt}" Style="{StaticResource DiagnosticLabel}" />
                                <TextBlock x:Name="AttemptValue" Grid.Row="8" Grid.Column="1" Style="{StaticResource DiagnosticValue}"
                                           Typography.NumeralAlignment="Tabular" />
                            </Grid>
                        </Border>

                        <Border Margin="0,12,0,0" Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="{i18n:Localized Diagnostics_ChargingModesTitle}" Style="{StaticResource SectionTitle}" />
                                <TextBlock Margin="0,4,0,14" Style="{StaticResource BodyMuted}"
                                           Text="{i18n:Localized Diagnostics_ChargingModesDescription}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Margin="0,0,6,0" Padding="14" CornerRadius="10" Background="{DynamicResource ControlBrush}">
                                        <StackPanel>
                                            <TextBlock Text="{i18n:Localized Mode_HomeRange}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Margin="0,5,0,0" Style="{StaticResource BodyMuted}"
                                                       Text="{i18n:Localized Diagnostics_HomeDescription}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="1" Margin="6,0" Padding="14" CornerRadius="10" Background="{DynamicResource ControlBrush}">
                                        <StackPanel>
                                            <TextBlock Text="{i18n:Localized Mode_OfficeRange}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Margin="0,5,0,0" Style="{StaticResource BodyMuted}"
                                                       Text="{i18n:Localized Diagnostics_OfficeDescription}" />
                                        </StackPanel>
                                    </Border>
                                    <Border Grid.Column="2" Margin="6,0,0,0" Padding="14" CornerRadius="10" Background="{DynamicResource ControlBrush}">
                                        <StackPanel>
                                            <TextBlock Text="{i18n:Localized Mode_TravelRange}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                            <TextBlock Margin="0,5,0,0" Style="{StaticResource BodyMuted}"
                                                       Text="{i18n:Localized Diagnostics_TravelDescription}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border x:Name="WifiPermissionPanel" Margin="0,12,0,0" Padding="18"
                                Background="{DynamicResource WarningSurfaceBrush}"
                                BorderBrush="{DynamicResource WarningBorderBrush}" BorderThickness="1"
                                CornerRadius="14" Visibility="Collapsed">
                            <DockPanel>
                                <Button DockPanel.Dock="Right" Margin="18,0,0,0" Click="OpenLocationSettings_Click" Content="{i18n:Localized Diagnostics_OpenSettings}" />
                                <StackPanel>
                                    <TextBlock Text="{i18n:Localized Diagnostics_WifiRestricted}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource BodyMuted}"
                                               Text="{i18n:Localized Diagnostics_LocationDescription}" />
                                </StackPanel>
                            </DockPanel>
                        </Border>

                        <Border Margin="0,12,0,8" Style="{StaticResource Card}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{i18n:Localized Diagnostics_HardwareCheck}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Margin="0,4,0,0" Style="{StaticResource BodyMuted}"
                                               Text="{i18n:Localized Diagnostics_HardwareCheckDescription}" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0">
                                    <ComboBox x:Name="HardwareModeComboBox" Width="230" Height="40" Margin="0,0,8,0"
                                              DisplayMemberPath="Name" SelectedValuePath="Mode" />
                                    <Button Click="RunHardwareDiagnostic_Click" Content="{i18n:Localized Diagnostics_Run}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Padding="18,12" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <DockPanel LastChildFill="False">
                <TextBlock x:Name="SaveHint" DockPanel.Dock="Left" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedTextBrush}" />
                <Button DockPanel.Dock="Right" Margin="8,0,0,0" Style="{StaticResource PrimaryButton}"
                        Click="Save_Click" Content="{i18n:Localized Common_Save}" />
                <Button DockPanel.Dock="Right" Click="Cancel_Click" Content="{i18n:Localized Common_Cancel}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
