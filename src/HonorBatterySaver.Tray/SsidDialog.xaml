<Window x:Class="HonorBatterySaver.Tray.SsidDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i18n="clr-namespace:HonorBatterySaver.Tray"
        Title="{i18n:Localized WifiRule_Title}" Width="540" Height="410" MinWidth="500" MinHeight="390"
        ResizeMode="CanResizeWithGrip" WindowStartupLocation="CenterOwner"
        Icon="{StaticResource AppLogoImage}"
        Background="{DynamicResource CanvasBrush}" FontFamily="Segoe UI Variable Text, Segoe UI"
        ShowInTaskbar="False" UseLayoutRounding="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="22,18" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock x:Name="DialogTitle" Text="{i18n:Localized WifiRule_AddTitle}" FontSize="20" FontWeight="SemiBold"
                           Foreground="{DynamicResource TextBrush}" />
                <TextBlock Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource MutedTextBrush}"
                           Text="{i18n:Localized WifiRule_Description}" />
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="1" Margin="22,18,22,14">
            <TextBlock Text="{i18n:Localized WifiRule_Network}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
            <ComboBox x:Name="NetworkComboBox" Margin="0,7,0,0" Height="44"
                      IsEditable="True" IsTextSearchEnabled="True" TextSearch.TextPath="Ssid"
                      StaysOpenOnEdit="True">
                <ComboBox.ItemContainerStyle>
                    <Style TargetType="ComboBoxItem" BasedOn="{StaticResource {x:Type ComboBoxItem}}">
                        <Setter Property="MinHeight" Value="44" />
                        <Setter Property="Padding" Value="10,7" />
                    </Style>
                </ComboBox.ItemContainerStyle>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinWidth="420">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Ssid}" FontWeight="SemiBold"
                                       Foreground="{DynamicResource TextBrush}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Padding="8,3" CornerRadius="6" Background="{DynamicResource BadgeBrush}">
                                <TextBlock Text="{Binding Status}" FontSize="11.5"
                                           Foreground="{DynamicResource MutedTextBrush}" />
                            </Border>
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBlock x:Name="NetworkListHint" Margin="0,6,0,16" FontSize="12"
                       Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" />

            <TextBlock Text="{i18n:Localized WifiRule_Profile}" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
            <ComboBox x:Name="ModeComboBox" Margin="0,7,0,0" Height="44"
                      DisplayMemberPath="Name" SelectedValuePath="Mode" />
            <TextBlock Margin="0,7,0,0" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"
                       Text="{i18n:Localized WifiRule_AcOnly}" />
        </StackPanel>

        <Border Grid.Row="2" Padding="18,12" Background="{DynamicResource SurfaceBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Margin="0,0,8,0" IsCancel="True" Content="{i18n:Localized Common_Cancel}" />
                <Button Style="{StaticResource PrimaryButton}" IsDefault="True"
                        Click="Accept_Click" Content="{i18n:Localized WifiRule_Save}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
